!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Test for Weertman friction law            !!
!!  optimise the Weertman friction coefficient!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

!---LUA BEGIN
! loadfile('Temperature.lua')()
! loadfile('materials.lua')()
!MinH=10.0
!---LUA END
! note viscosity.lua assumes SI units!

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! OPTIMISATION PARAMETERS
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Name of the RUN 
! Sweep parameters come from a generated include (runelmer_multiple.sh regenerates it
! per parameter combination; for a manual single run just edit params.sif).
! NOTE: no trailing comment on the include line below -- Elmer reads the whole
! rest of the line as the filename, so a comment would be swallowed into it.
! params.sif (or the generated params_<tag>.sif) defines: res, neLo, neUp, area, idwpow, nn
include "params.sif"
$name="BowdoinVE_v1_incmp" ! outputt name
$restartfile="Bowdoin_v1_init_incmp" ! name of restart
$directsolver="MUMPS" ! not needed at the moment
! TODO add shearband!

!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! TEST PARAMETERS
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!### physical constants

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Header
  Mesh DB "." "footprint_bc_$res$"
  Results Directory "./VTU_footprint_$res$_A$area$"
End
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Simulation
  Coordinate System  = Cartesian 3D
  Simulation Type = "transient"

  Steady State Min Iterations = 1
  Steady State Max Iterations = 1

  Timestepping Method = "bdf"
  BDF Order = 2
  Timestep Intervals = #2*235 ! we have 235 records in 2s intervalls
  Timestep Sizes = 1
  Output Intervals = 10 ! applies only to result file (needed for eventual restart)
  
  ! transient restart file not needed for the sweep -> disabled (would collide
  ! across area values within a resolution anyway, as it carries only the run name).

  !! restart True solution
  Restart File = "$restartfile$.result"
  Restart Before Initial Conditions = logical True
  Restart Position = 0
  Restart Time = 0.0
  Restart Variable 1 = "Disp 1"
  Restart Variable 2 = "Disp 2"
  Restart Variable 3 = "Disp 3"
  Restart Variable 4 = "Pressure"
  Restart Variable 5 = "zb"
  Restart Variable 6 = "thickness"
  Restart Variable 7 = "Cryostatic Pressure"
  Restart Variable 8 = "Ocean Pressure"
  Restart Variable 9 = "depth"
  Restart Variable 10 = "height"
  Restart Variable 11 = "BC mask"

  Initialize Dirichlet Conditions = Logical False
  
  include "meshextrushion.sif"
  
  Preserve baseline = Logical True
  
  max output level = 5
End

Constants
  Water Density = Real #rhow
  ! Stuff defining the attachment coordinates
  Reference Coordinate(3) = Real 509870.0 8621580.0 0.0
  ! z woud be 4.01708358e+01
  Start Coordinate (3)= Real 509577.5 8621975.0 0.0
  Stop Coordinate (3)= Real 509232.5 8622540.0 0.0
  Minimum Distance = Real 495.0
  Maximum Distance = Real 1145.0
End

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Bodies
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Body 1
  Name = "glacier"
  Equation = 1
  Body Force = 1
  Material = 1
  Initial Condition = 1
End

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Initial Conditions
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Initial Condition 1
  ! remember last deformation of initialization run (to obtain relative in transient run)
  Disp Offset 1 = Equals Disp 1
  Disp Offset 2 = Equals Disp 2
  Disp Offset 3 = Equals Disp 3 
End

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!  Body Forces
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Body Force 1
  Stress Bodyforce 1 = 0.0
  Stress Bodyforce 2 = 0.0
  Stress Bodyforce 3 = #-gravity*rhoi
  Cryostatic Pressure = Variable Depth
    Real LUA "rhoi*gravity*tx[0]"
  Ocean Pressure = Variable Coordinate 3
    Real LUA "rhow*gravity*IfThenElse(tx[0] < 0.0, -1.0*tx[0], 0.0)" 
  Temperature = Variable Depth
         real lua "temperature(tx[0])"
End

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Materials
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Material 1
 Density = Real #rhoi

 Sea Level = Variable Time
   Real Lua "tides(tx[0])"
 
 Viscosity Model = String "Glen"
 Viscosity = Real 2.5 

!---- Parametres for Glen Viscosity
 Relative Temperature = Equals Temperature
 Glen Exponent = Real 3.0
 Glen Enhancement Factor = Real 1.0
 Limit Temperature = Real -10.0e00
 Rate Factor 1 = Real #A1
 Activation Energy 1 = Real #Q1
 Rate Factor 2 = Real #A2
 Activation Energy 2 = Real #Q2
 Critical Shear Rate = Real 1.0e-12

! Elasticity
 Youngs Modulus = #Eyoung
 Poisson Ratio = #1.0/3.0
 Damping = Real 0.0
End

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Solvers
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

!! Before simulation

!%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Solver 1
  Exec Solver = "before simulation"
  Equation = "MapCoordinate"
  Procedure = "StructuredMeshMapper" "StructuredMeshMapper"

  Active Coordinate = Integer 3

  Displacement Mode = Logical False
  Correct Surface = Logical True
  Minimum Height = Real #MinH

  Correct Surface Mask = String "Glaciated"
  Dot Product Tolerance = 1.0e-3

  ! These are needed to host the variables that are read in
  Variable = -nooutput "DummyMesh"
End

Solver 2
   Equation = "compute distance"
   Exec Solver = "Before Simulation"
   Procedure = "BIN/InterpolateByDistance.so" "InterpolateByDistance"
   Variable = -dofs 1 "Dist"
   ! iceberg between 495 and 1145 m
   Exported Variable 1 = "In Contact"
End

! before timestep
Solver 3
    Exec Solver = "Before Timestep"      ! once per step, before the physics
    Equation = "FrontField"
    Procedure = "BIN/FrontFieldFromCloud" "FrontFieldFromCloud"
    Variable = -nooutput "dummy_ffc"
    Variable DOFs = 1
    Exported Variable 1 = "FrontPressure"
    Exported Variable 1 DOFs = 1
    Subtract Hydrostatic Pressure = Logical True
    Restore Hydrostatic Pressure  = Logical False
    
    Data File Prefix = File "loads/forces_Bowdoin_v1/Pressure_t_"
    Data File Suffix = File ".csv"
    Value Column = Integer 4
    
    Data Time Start  = Integer 2
    Data Time End    = Integer 470
    Data Time Step   = Integer 2      ! probe stride; step 1 also works, just more stat() calls
    
    Number Of Neighbours = Integer $nn
    IDW Power = Real $idwpow
    Snap Tolerance = Real 1.0e-9
  End
  
Solver 4
  Exec Solver = "Before Timestep"
  Equation = "IcebergLoad"
  Procedure = "BIN/IcebergFrontLoad" "IcebergFrontLoad"
  Variable = -nooutput "dummy_ibl"
  Variable DOFs = 1
  Exported Variable 1 = "IcebergNormalTraction"
  Exported Variable 1 DOFs = 1
  Exported Variable 2 = "IcebergForce3"
  Exported Variable 2 DOFs = 1

  Force File  = File "loads/forces_Bowdoin_v1/Fc.dat"
  Motion File = File "loads/forces_Bowdoin_v1/Mvt_Frame_body_TopLeftCorner.dat"
  Motion Z Column = Integer 3
  Attachment Area Bandwidth = Real $area   ! [m] vertical extent of the band
  Normal Force Sign = Real -1.0           ! push -> negative for "Normal Force"
End
Solver 5
  Equation = "Linear elasticity"
  Procedure = "StressSolve" "StressSolver"
  Variable =  String "t [Disp:3 Pressure:1]"
  Variable DOFs = 4
  Steady State Convergence Tolerance = 1.0e-3

  ! ---- linear solver + preconditioner ONLY: pick ONE, toggle the '!' --------
  !   ILU3_GCR.sif : monolithic GCR + ILU3 (original -- works, scales poorly) [ACTIVE]
  !   MUMPS.sif    : direct, robust for the saddle-point (not weak-scalable, breaks >1024 cores)
  ! The block-Schur variants below all FAIL for this incompressible+Maxwell StressSolve
  ! (un-exercised in Elmer; need a source fix, not a sif change):
  !   BPC_2.sif    : native "elast schur" never created -> fatal
  !   BPC_4.sif    : 4-block Gauss-Seidel diverges (no pressure Schur)
  !   BPC_2G.sif   : generic Schur -- serial-only (Create Schur) or MPI SIGABRT (Schur Operator)
  ! NB: no trailing comment on an include line (Elmer swallows it into the
  !     filename -> OpenIncludeFile); switch by moving the '!' only.
  include "ILU3_GCR.sif"
  !include "MUMPS.sif"
  !include "BPC_2G.sif"
  !include "BPC_2.sif"

  Nonlinear System Convergence Tolerance = 1.0e-3
  Nonlinear System Max Iterations = 20
  Nonlinear System Relaxation Factor = #6.0/7.0

  Element = "p:1 b:1"
  Incompressible = Logical True
  Time Derivative Order = 1
  Maxwell material=Logical True
  Apply Limiter = Logical True
  Save Limiter = Logical True
  Calculate Velocity = Logical True
  Displace Mesh =  Logical False

! Create variables required for the optimisation
  Exported Variable 4 = -dofs 1 "BC mask"
  Exported Variable 3 = -dofs 3 "Disp Offset"
  Exported Variable 2 = -dofs 3 "Uobs"
  Exported Variable 1 = -dofs 1 "Temperature"
  Update Exported Variables = Logical True
End

Solver 6
  Equation = "saveadiosbulk"
  Exec Solver = "After Timestep"
  Procedure = "ADIOS2OutputSolver" "ADIOS2OutputSolver"
  Scalar field 1 = "pressure"
  Scalar field 2 = "Disp 1"
  Scalar field 3 = "Disp 2"
  Scalar field 4 = "Disp 3"
  Scalar field 5 = "depth"
  Scalar field 6 = "Disp Offset 1"
  Scalar field 7 = "Disp Offset 2"
  Scalar field 8 = "Disp Offset 3"
  Scalar field 9 = String "icebergforce3"
  Scalar field 10 = String "frontpressure"
  Scalar field 11 = String "icebergnormaltraction"
  Scalar field 12 = String "BC mask"
  
  output file name = "$name$_$res$_A$area$_p$idwpow$_k$nn$-bulk.bp"
  Solver Timing = Logical True
End

! Dump front (BC 6, Target boundary 7): Disp, FrontPressure, iceberg tractions -> ASCII
Solver 7
  Exec Solver = "After Timestep"
  Equation = "SaveFront"
  Procedure = "SaveData" "SaveLine"
  Variable = -nooutput "dummy_sl"
  Filename = File "$name$_$res$_A$area$_p$idwpow$_k$nn$_front.dat"
  File Append = Logical True
  Parallel Reduce = Logical True       ! gather partitions into one file (drop -> one file/rank)
  Variable 1 = String "Disp"           ! auto-expands to Disp 1, Disp 2, Disp 3
  Variable 2 = String "FrontPressure"
  Variable 3 = String "IcebergNormalTraction"
  Variable 4 = String "IcebergForce3"
End

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Equations
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! bulk
Equation 1
  Active Solvers(7) = 1 2 3 4 5 6 7
End

! Top

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Boundary Conditions
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Boundary Condition 1
  Target Boundaries(1) = 4 
  Name = "back"
  Disp 1 = Real 0.0
  Disp 2 = Real 0.0
  Disp 3 = Real 0.0
End

Boundary Condition 2
  Target Boundaries(2) = 1 2
  Name = "side"
  Disp 1 = Real 0.0
  Disp 2 = Real 0.0
  Disp 3 = Real 0.0
End

Boundary Condition 3
  Target Boundaries(1) = 3
  Name = "groundingline" 
  Disp 1 = Real 0.0
  Disp 2 = Real 0.0
  Disp 3 = Real 0.0
End

Boundary Condition 4
  Target Boundaries(1) = 8 
  Name = "back extruded"
  Disp 1 = Real 0.0
  Disp 2 = Real 0.0
  Normal Force = Equals "Cryostatic Pressure"
End

Boundary Condition 5
  Target Boundaries(2) = 5 6
  Name = "side extruded"
  Normal Force = Opposes "Cryostatic Pressure"
  Disp 2 = Real 0.0
  Disp 3 = Real 0.0
End

Boundary Condition 6
  Target Boundaries(1) = 7
  Name = "calvingfront"
  Save Line = Logical True            ! picked up by SaveLine (Solver 7)
  Front Interpolation = Logical True
  Iceberg Attachment  = Logical True
  Normal Force  = Variable FrontPressure, Ocean Pressure, IcebergNormalTraction ! iceberg normal (signed) and point cloud pressure
       Real LUA "-tx[0] - tx[1] + tx[2]"
  Force 3 = Equals "IcebergForce3"   
  BC Mask = Real 1.0
End

Boundary Condition 7
  Name = "bed" ! necessary for adjoint!  
  
  Height = Real 0.0

  Disp 1 = Real 0.0
  Disp 2 = Real 0.0
  Disp 3 Lower Limit = Real 0.0
  Disp 3 Lower Initial = Real 1.0

  Normal Force = Variable Ocean Pressure, t contact active 3, Coordinate 2
      Real LUA "tx[0]*IfThenElse(tx[1] < 0.0, 0.0, -1.0)*IfThenElse(tx[2] > maxy,0.0,1.0)"
  Bottom Surface = Equals "zb"
  BC Mask = Real 2.0
End

Boundary Condition 8
  Name = "surface" 
  Top Surface = Variable "zb", "thickness"
   Real LUA "tx[0] + tx[1]"
  BC Mask = Real 3.0 
End
